/* =========================================================
   HNC AGENT MODERN - SOFTPHONE AUTO HIDE
   ========================================================= */

#softphonePanel {
    transition: width 0.25s ease,
                min-width 0.25s ease,
                opacity 0.25s ease,
                transform 0.25s ease !important;
    position: relative !important;
}

/* Collapsed state */
#softphonePanel.hnc-softphone-hidden {
    width: 0 !important;
    min-width: 0 !important;
    max-width: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    overflow: visible !important;
}

/* Hide actual softphone contents */
#softphonePanel.hnc-softphone-hidden #left_sidebar {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
}

/* Floating open button */
#hncSoftphoneToggle {
    position: fixed;
    right: 14px;
    top: 250px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: #167a50;
    color: #ffffff;
    font-size: 22px;
    line-height: 48px;
    text-align: center;
    cursor: pointer;
    z-index: 99999;
    box-shadow: 0 4px 14px rgba(0,0,0,.18);
    transition: all .2s ease;
}

#hncSoftphoneToggle:hover {
    transform: scale(1.06);
}

/* When phone is open, keep toggle attached near panel */
#softphonePanel:not(.hnc-softphone-hidden) + #hncSoftphoneToggle {
    background: #1b4e80;
}

/* Desktop only */
@media (min-width: 768px) {

    #softphonePanel.hnc-softphone-hidden {
        flex: 0 0 0 !important;
    }

}


