/*
 * HNC Smart CRM - Modern Agent Panel
 *
 * Development theme only.
 * Existing VICIdial call logic is untouched.
 */

/* =========================================================
   HNC AGENT THEME FOUNDATION
   ========================================================= */

:root {
    --hnc-green-dark: #164b35;
    --hnc-green: #167a50;
    --hnc-green-soft: #e7f7ed;
    --hnc-green-light: #f4faf6;

    --hnc-text: #355944;
    --hnc-text-muted: #719083;

    --hnc-border: #dce9df;
    --hnc-border-soft: #e8f1eb;

    --hnc-white: #ffffff;

    --hnc-radius: 10px;
    --hnc-radius-small: 7px;

    --hnc-shadow: 0 2px 10px rgba(25, 80, 55, 0.08);
}

/* Basic page foundation */

html,
body {
    background: #f5faf7 !important;
    color: var(--hnc-text) !important;
}

/* Modern typography */

body,
button,
input,
select,
textarea {
    font-family: "Montserrat", Arial, sans-serif !important;
}

/* Links */

a {
    color: var(--hnc-green) !important;
}

a:hover {
    color: var(--hnc-green-dark) !important;
}

/* =========================================================
   COMMON MODERN CARD
   ========================================================= */

.hnc-agent-card {
    background: var(--hnc-white);
    border: 1px solid var(--hnc-border);
    border-radius: var(--hnc-radius);
    box-shadow: var(--hnc-shadow);
}

/* =========================================================
   FORM CONTROLS
   ========================================================= */

input,
select,
textarea {
    border-color: var(--hnc-border) !important;
}

input:focus,
select:focus,
textarea:focus {
    border-color: #9bc9ae !important;
    outline: none !important;
    box-shadow: 0 0 0 2px rgba(22, 122, 80, 0.08) !important;
}

/* =========================================================
   BUTTON FOUNDATION
   ========================================================= */

button,
input[type="button"],
input[type="submit"] {
    border-radius: var(--hnc-radius-small);
}

/* =========================================================
   SAFE DEVELOPMENT MARKER
   ========================================================= */

body::after {
    content: "HNC AGENT MODERN";
    position: fixed;
    bottom: 6px;
    right: 8px;
    z-index: 99999;

    padding: 3px 7px;
    border-radius: 5px;

    background: rgba(22, 122, 80, 0.08);
    color: rgba(22, 122, 80, 0.55);

    font-size: 8px;
    font-weight: 600;
    pointer-events: none;
}

/* =========================================================
