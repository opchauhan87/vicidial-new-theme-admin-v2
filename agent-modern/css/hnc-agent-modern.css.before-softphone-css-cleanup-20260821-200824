/* ---------------------------------------------------------
   FORM GROUPS
   --------------------------------------------------------- */

#MainPanelCustInfo .bg-gray .form-group {
    margin-bottom: 14px !important;
}

#MainPanelCustInfo .bg-gray label {
    display: block;
    margin-bottom: 6px !important;
    color: var(--hnc-text-muted) !important;
    font-size: 12px !important;
    font-weight: 600 !important;
}

/* ---------------------------------------------------------
   CUSTOMER INPUTS
   Existing IDs/names/classes untouched
   --------------------------------------------------------- */

#MainPanelCustInfo input.customer-page,
#MainPanelCustInfo select.customer-page,
#MainPanelCustInfo textarea.customer-page {
    width: 100% !important;
    min-height: 40px;
    padding: 8px 11px !important;

    background: #ffffff !important;
    color: var(--hnc-text) !important;

    border: 1px solid var(--hnc-border) !important;
    border-radius: 8px !important;

    box-shadow: none !important;
    transition: border-color .15s ease,
                box-shadow .15s ease,
                background .15s ease !important;
}

/* Focus */
#MainPanelCustInfo input.customer-page:focus,
#MainPanelCustInfo select.customer-page:focus,
#MainPanelCustInfo textarea.customer-page:focus {
    border-color: var(--hnc-green) !important;
    background: #ffffff !important;
    outline: none !important;
    box-shadow: 0 0 0 3px rgba(22, 122, 80, 0.08) !important;
}

/* Disabled / readonly */
#MainPanelCustInfo input.customer-page:disabled,
#MainPanelCustInfo select.customer-page:disabled,
#MainPanelCustInfo textarea.customer-page:disabled {
    background: #f3f7f4 !important;
}

/* ---------------------------------------------------------
   ROW SPACING
   --------------------------------------------------------- */

#MainPanelCustInfo .bg-gray > .row {
    margin-left: -8px !important;
    margin-right: -8px !important;
}

#MainPanelCustInfo .bg-gray > .row > [class*="col-md-"] {
    padding-left: 8px !important;
    padding-right: 8px !important;
}

/* ---------------------------------------------------------
   CONTACT / NOTES
   --------------------------------------------------------- */

#MainPanelCustInfo textarea.customer-page {
    min-height: 70px;
    resize: vertical;
}

/* ---------------------------------------------------------
   REMOVE OLD VISUAL NOISE
   --------------------------------------------------------- */

#MainPanelCustInfo .colorgraph {
    border-radius: 2px;
}

/* ---------------------------------------------------------
   SCROLLBAR
   --------------------------------------------------------- */

#MainPanelCustInfo .bg-gray::-webkit-scrollbar {
    width: 7px;
}

#MainPanelCustInfo .bg-gray::-webkit-scrollbar-track {
    background: #f1f6f3;
}

#MainPanelCustInfo .bg-gray::-webkit-scrollbar-thumb {
    background: #c6dacf;
    border-radius: 10px;
}

#MainPanelCustInfo .bg-gray::-webkit-scrollbar-thumb:hover {
