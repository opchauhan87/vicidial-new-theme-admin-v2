}
.table_list tbody tr:hover {
	transform: scale(1.02, 1.02);
	position: relative;
	z-index: 20;
	box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
	border-width: 0;
	border-radius: 0.25rem;
	background: #ffffff !important;
}
.custom-input {
  position: relative;
  z-index: 0;
}
.custom-input label {
  position: absolute;
  margin-bottom: 0;
  padding: 0 5px;
  background: white;
  z-index: 3;
}
.custom-input .form-control {
  outline: none;
  box-shadow: none;
}
.custom-input .form-control:hover, .custom-input .form-control:focus {
  border-color: #35a7db;
}
.custom-input .form-control {
  /*margin-top: 12px;*/
}
.custom-input i {
  font-size: 20px;
  cursor: pointer;
}
.custom-input .form-control ~ label {
  top: -12px;
  left: 8px;
}
