    #MainPanelCustInfo .bg-gray .row > .col-md-3,
    #MainPanelCustInfo .bg-gray .row > .col-md-12 {
        width: 100% !important;
    }

}


/* =========================================================
   HNC AGENT MODERN - SOFTPHONE AUTO HIDE
   ========================================================= */

#softphonePanel {
    transition: width 0.25s ease,
                min-width 0.25s ease,
                opacity 0.25s ease,
                transform 0.25s ease !important;
    position: relative !important;
}

/* Collapsed state */
#softphonePanel.hnc-softphone-hidden {
    width: 0 !important;
    min-width: 0 !important;
    max-width: 0 !important;
    padding: 0 !important;
    margin: 0 !important;
    overflow: visible !important;
}

/* Hide actual softphone contents */
#softphonePanel.hnc-softphone-hidden #left_sidebar {
    opacity: 0 !important;
    visibility: hidden !important;
    pointer-events: none !important;
}

/* Floating open button */
#hncSoftphoneToggle {
    position: fixed;
    right: 14px;
    top: 250px;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: none;
    background: #167a50;
    color: #ffffff;
    font-size: 22px;
    line-height: 48px;
    text-align: center;
    cursor: pointer;
    z-index: 99999;
    box-shadow: 0 4px 14px rgba(0,0,0,.18);
    transition: all .2s ease;
}

#hncSoftphoneToggle:hover {
    transform: scale(1.06);
}

/* When phone is open, keep toggle attached near panel */
#softphonePanel:not(.hnc-softphone-hidden) + #hncSoftphoneToggle {
    background: #1b4e80;
}

/* Desktop only */
@media (min-width: 768px) {

    #softphonePanel.hnc-softphone-hidden {
        flex: 0 0 0 !important;
    }

}


/* =========================================================
   HNC AGENT MODERN - SOFTPHONE DRAWER
   Phase: Safe Overlay
   Existing VICIdial call logic untouched
   ========================================================= */

#softphonePanel {
    position: fixed !important;

    top: 82px !important;
    right: 0 !important;
    bottom: 35px !important;

    width: 360px !important;
    max-width: 360px !important;

    z-index: 9900 !important;

    margin: 0 !important;
    padding: 0 !important;

    background: #ffffff !important;

    border-left: 1px solid var(--hnc-border) !important;

    box-shadow: -6px 0 22px rgba(25, 80, 55, 0.12) !important;

    transition:
        transform .28s ease,
        opacity .28s ease !important;
}

/* Softphone internal area */
#softphonePanel #left_sidebar {
    width: 100% !important;
    height: 100% !important;

    overflow-y: auto !important;
}

/* Hidden state */
#softphonePanel.hnc-softphone-hidden {
    transform: translateX(100%) !important;
    opacity: 0 !important;

    pointer-events: none !important;
}

/* =========================================================
   SOFTPHONE TOGGLE
   ========================================================= */

#hncSoftphoneToggle {
    position: fixed !important;

    right: 14px !important;
    top: 220px !important;

    width: 46px !important;
    height: 46px !important;

    padding: 0 !important;

    border: 0 !important;
    border-radius: 50% !important;

    background: var(--hnc-green) !important;
    color: #ffffff !important;

    font-size: 20px !important;
    line-height: 46px !important;
    text-align: center !important;

    cursor: pointer !important;

    z-index: 99999 !important;

    box-shadow: 0 4px 14px rgba(25, 80, 55, .20) !important;

    transition: transform .18s ease,
                right .28s ease !important;
}

#hncSoftphoneToggle:hover {
    transform: scale(1.06) !important;
}

/* When phone is open */
#softphonePanel:not(.hnc-softphone-hidden)
~ #hncSoftphoneToggle {
    right: 374px !important;
}

/* Softphone header area should remain visible */
#softphonePanel .page-wrap {
    height: 100% !important;
}

/* Scrollbar */
#softphonePanel #left_sidebar::-webkit-scrollbar {
    width: 6px !important;
}

#softphonePanel #left_sidebar::-webkit-scrollbar-track {
    background: #f3f8f5 !important;
}

#softphonePanel #left_sidebar::-webkit-scrollbar-thumb {
    background: #c4d9cb !important;
    border-radius: 6px !important;
}

@media (max-width: 767px) {

    #softphonePanel {
        top: 60px !important;
        bottom: 0 !important;
        width: 100% !important;
        max-width: 100% !important;
    }

    #softphonePanel.hnc-softphone-hidden {
        transform: translateX(100%) !important;
    }

    #hncSoftphoneToggle {
        right: 12px !important;
        top: 180px !important;
    }

}

